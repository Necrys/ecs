# clang-tidy configuration.
#
# The families are the ones the plan names (3.4): bugprone, performance,
# modernize, readability and cppcoreguidelines. What is switched off is switched
# off for a stated reason, because a check disabled in silence is worse than one
# that was never enabled.
#
# Disabled deliberately:
#   readability-identifier-length         - the style guide allows id, idx, pos, ptr
#   readability-uppercase-literal-suffix  - the sources use lowercase suffixes throughout
#   modernize-use-trailing-return-type    - CODE_STYLE keeps classic return types
#   readability-magic-numbers             - masks and sizes are named by their context
#   cppcoreguidelines-avoid-magic-numbers
#   cppcoreguidelines-pro-type-vararg     - printf is the benchmark harness output
#   cppcoreguidelines-owning-memory       - the page allocates raw memory on purpose
#   cppcoreguidelines-avoid-c-arrays      - data blobs are arrays for cache layout
#   modernize-avoid-c-arrays
#   cppcoreguidelines-pro-bounds-constant-array-index
#                                         - the page indexes its arrays by slot by design
#   readability-named-parameter           - an unnamed parameter is how the code says
#                                           "unused"; naming it would trip -Wunused-parameter
#   cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
#                                         - the containers index storage whose bounds they
#                                           have already established; the checked form would
#                                           be a cost on the hot path (see D15)
#   cppcoreguidelines-pro-type-reinterpret-cast
#   cppcoreguidelines-pro-bounds-array-to-pointer-decay
#   cppcoreguidelines-pro-bounds-pointer-arithmetic
#                                         - the page is raw bytes carved into slots, which is
#                                           the same design the disabled
#                                           -Wno-unsafe-buffer-usage already accepts (D15)
#   cppcoreguidelines-avoid-const-or-ref-data-members
#                                         - a handle or a view refers to what it views: entity
#                                           holds its registry, a storage holds its component
#                                           storage, a selection holds what it walks
#   cppcoreguidelines-non-private-member-variables-in-classes
#                                         - system_base's state belongs to the systems derived
#                                           from it, not to its users
#
# Findings are a gate. The first run produced 46, all of them dealt with (fixed or
# disabled above with a reason). The second round found that the header filter below
# never matched on Windows, so the checks had only ever seen .cpp files: once the
# filter worked, twenty-eight checks reported in the public headers - some fixed,
# some disabled above, and none of them accepted as a standing report.
---
Checks: >-
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-*,
  -readability-identifier-length,
  -readability-uppercase-literal-suffix,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -readability-named-parameter,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-non-private-member-variables-in-classes

WarningsAsErrors: '*'

# Paths arrive with the platform's separators: backslashes on Windows, slashes
# elsewhere. A regex written for one of them silently turned the header filter off on
# the other, which is how the whole backlog of findings inside lib/include stayed
# invisible until a Linux run reported 2578 of them.
HeaderFilterRegex: '(lib[\\/]include|lib[\\/]src|tests)[\\/].*'

FormatStyle: file

CheckOptions:
  # The repository's own naming rule: short names are fine when they are the
  # conventional ones. This keeps the option documented even though the check
  # itself is off.
  readability-identifier-naming.IgnoreMainLikeFunctions: 'true'
